# Runtime PostgreSQL connection URL (connects as least-privilege app_rw role)
DATABASE_URL=

# Schema migration PostgreSQL connection URL (connects as DDL owner app_owner; used only by Alembic)
MIGRATION_DATABASE_URL=

# PostgreSQL test database connection URL (used strictly by pytest test suite)
TEST_DATABASE_URL=

# Local PostgreSQL container password for docker compose
LOCAL_DB_PASSWORD=

# Application execution profile: dev | test | demo | prod
APP_ENV=demo

# Demo access key for gating public demo deployment (required when APP_ENV=demo; pass via X-Demo-Key header or /docs gate)
DEMO_ACCESS_KEY=

# Webhook HMAC secret for mock payment provider (generate with: python -c "import secrets; print(secrets.token_hex(32))")
WEBHOOK_HMAC_KEY=

# Webhook Key Identifier for HMAC key rotation
WEBHOOK_KEY_ID=wh_demo_key

# Audit HMAC secret for tamper-evident ledger hash chaining (32-byte hex secret)
AUDIT_HMAC_KEY=

# Audit Key Identifier for tamper-evident ledger key rotation
AUDIT_KEY_ID=audit_demo_key

# PII AES-256-GCM encryption key (32-byte hex secret)
PII_ENC_KEY=

# PII Blind Index HMAC-SHA256 secret for exact match lookups (32-byte hex secret)
PII_BLIND_INDEX_KEY=

# PII Key Identifier for encryption key rotation
PII_KEY_ID=pii_demo_key

# Enable or disable slowapi rate limiting (true | false)
RATE_LIMIT_ENABLED=true

# Rate limit for user registration endpoint
RATE_LIMIT_USER_REGISTRATION=5/minute

# Default rate limit for authenticated user endpoints
RATE_LIMIT_AUTHENTICATED=60/minute

# Rate limit for settlement initiation endpoints
RATE_LIMIT_SETTLEMENTS=10/minute

# Maximum allowed HTTP request body size cap in bytes (64 KB cap)
MAX_REQUEST_BODY_BYTES=65536
