# Database connection URL (PostgreSQL 16)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/akira

# Application environment: dev | test | prod
APP_ENV=dev

# Webhook HMAC secret for mock payment provider (32-byte hex secret)
WEBHOOK_HMAC_KEY=

# Webhook Key Identifier for key rotation
WEBHOOK_KEY_ID=

# Audit HMAC secret for tamper-evident hash chaining (32-byte hex secret)
AUDIT_HMAC_KEY=

# Audit Key Identifier for key rotation
AUDIT_KEY_ID=
