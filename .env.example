# Database connection URL (PostgreSQL 16)
DATABASE_URL=postgresql+psycopg://postgres:your_db_password@localhost:5432/akira
TEST_DATABASE_URL=postgresql+psycopg://postgres:your_db_password@localhost:5432/akira_test

# Local PostgreSQL database password for docker-compose
LOCAL_DB_PASSWORD=

# Application environment: dev | test | prod
APP_ENV=dev

# Webhook HMAC secret for mock payment provider (32-byte hex secret)
WEBHOOK_HMAC_KEY=

# Webhook Key Identifier for key rotation
WEBHOOK_KEY_ID=wh_dev_key

# Audit HMAC secret for tamper-evident hash chaining (32-byte hex secret)
AUDIT_HMAC_KEY=

# Audit Key Identifier for key rotation
AUDIT_KEY_ID=audit_dev_key

# PII AES-256-GCM encryption key (32-byte hex key)
PII_ENC_KEY=

# PII Blind Index HMAC key for exact match lookups (32-byte hex key)
PII_BLIND_INDEX_KEY=

# PII Key Identifier for key rotation
PII_KEY_ID=pii_dev_key
